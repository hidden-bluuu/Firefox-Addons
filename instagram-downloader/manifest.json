{
  "manifest_version": 3,
  "name": "Instagram Post Downloader",
  "version": "1.3.0",
  "description": "Downloads every photo and video in an Instagram post at the highest available resolution.",
  "homepage_url": "https://github.com/hidden-bluuu/instagram-downloader",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Instagram Post Downloader",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "download-post": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Download the open Instagram post"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "instagram-post-downloader@hidden-bluuu",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
